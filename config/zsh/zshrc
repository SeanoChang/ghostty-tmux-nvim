# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── oh-my-zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# ── prompt & completion plugins (homebrew) ───────────────────────────────────
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# To customize the prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# ── PATH ─────────────────────────────────────────────────────────────────────
export PATH="/opt/bin:$PATH"                              # gtkwave
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
export PATH="$PATH:$HOME/.local/bin"                      # pipx

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ── aliases ──────────────────────────────────────────────────────────────────
alias ls='eza --icons --group-directories-first'
alias lt='eza --tree --level=2'
alias ld='eza -lD'
alias lf='eza -lF --color=always | grep -v /'
alias lh='eza -dl .* --group-directories-first'
alias ll='eza -al --group-directories-first'

# ── functions ────────────────────────────────────────────────────────────────

# delete every local branch already merged into main/develop
gbda() {
    git branch --no-color --merged | command grep -vE "^[*]|\s*($(git_main_branch)|$(git_develop_branch))\s*$" | command xargs git branch --delete 2>/dev/null
}

# yazi wrapper: `y` cds to wherever you quit
y() {
  local tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  [ -f "$tmp" ] && cwd="$(cat "$tmp")" && [ "$cwd" != "$PWD" ] && builtin cd "$cwd"
  rm -f "$tmp"
}

# list the directory on every cd
chpwd() { eza -1 --icons --group-directories-first --git-ignore | head -20 }

# ── conda (lazy-loaded: the shim replaces itself on first call) ──────────────
conda() {
    unfunction conda
    __conda_setup="$('/opt/homebrew/Caskroom/miniconda/base/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh" ]; then
            . "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
        else
            export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"
        fi
    fi
    unset __conda_setup
    conda "$@"
}

# ── fzf / zoxide ─────────────────────────────────────────────────────────────
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
eval "$(zoxide init zsh)"          # gives you `z`
source <(fzf --zsh)                # Ctrl-T paths, Ctrl-R history, Alt-C cd

# ── fzf-tab ──────────────────────────────────────────────────────────────────
autoload -Uz compinit && compinit
source ~/.zsh/fzf-tab/fzf-tab.plugin.zsh

# fzf-tab needs the default menu disabled
zstyle ':completion:*' menu no
zstyle ':completion:*' file-sort modification

# preview directory contents when completing cd
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --icons --color=always --group-directories-first $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --icons --color=always $realpath'

# preview anything else: dir listing or file contents
zstyle ':fzf-tab:complete:*:*' fzf-preview '[ -d $realpath ] && eza -1 --icons --color=always $realpath || bat -n --color=always --line-range=:80 $realpath 2>/dev/null'

zstyle ':fzf-tab:*' fzf-flags --height=60% --layout=reverse --preview-window=right:55%:wrap
zstyle ':fzf-tab:*' switch-group '<' '>'

# ── zsh syntax highlighting (must be last) ───────────────────────────────────
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
