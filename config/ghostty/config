# Ghostty config — mirrors iTerm2 "Default" profile
# Docs: ghostty +show-config --default --docs | less

# ── Look (extracted from iTerm2 profile) ────────────────
font-family = MesloLGS NF
font-size = 13

background = #131a1b
foreground = #f2fcff
cursor-color = #bbbbbb
cursor-text = #eae1ea
selection-background = #588b8b
selection-foreground = #000000

# stock iTerm2 ANSI palette
palette = 0=#000000
palette = 1=#bb0000
palette = 2=#00bb00
palette = 3=#bbbb00
palette = 4=#0000bb
palette = 5=#bb00bb
palette = 6=#00bbbb
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff

# iTerm2: Transparency 0.204, Blur on (radius 10)
background-opacity = 0.80
background-blur-radius = 10

cursor-style = block
mouse-hide-while-typing = true
window-padding-x = 6
window-padding-y = 4

# ── macOS feel ──────────────────────────────────────────
macos-titlebar-style = tabs
window-save-state = always
confirm-close-surface = false
shell-integration = detect

# Quick dropdown terminal (iTerm2 hotkey-window equivalent)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ── Splits: iTerm2 muscle memory ────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# ── Tabs (cmd+t/w and cmd+1..9 are Ghostty defaults) ────
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab

# ── Clear screen like iTerm2 ────────────────────────────
keybind = cmd+k=clear_screen
